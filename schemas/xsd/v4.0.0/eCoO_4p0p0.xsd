                          </xs:element>
                          <xs:element name="CountryCode" type="ds:AddressCountryCodeType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Address. Country. Code</xs:documentation>
                              <xs:documentation source="Definition">Code specifying the name of the country or other geographical entity as specified in ISO 3166 and UN/ECE Rec 3.</xs:documentation>
