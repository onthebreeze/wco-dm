  <xs:element name="LPCO">
    <xs:annotation>
      <xs:documentation source="Definition">Details related to Licenses, Permits, Certificates or Others.</xs:documentation>
      <xs:documentation source="WCO ID">74B</xs:documentation>
      <xs:documentation source="Unique Position ID">0001L</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="IssueDateTime" type="ds:LPCOIssueDateTimeType" minOccurs="0">
          <xs:annotation>
            <xs:documentation source="Dictionary Entry Name">LPCO. Issue. Date Time</xs:documentation>
            <xs:documentation source="Definition">Date and time the document was issued and when appropriate, signed or otherwise authenticated.</xs:documentation>
            <xs:documentation source="WCO ID">D011</xs:documentation>
            <xs:documentation source="Unique Position ID">0001L</xs:documentation>
            <xs:documentation source="Format">an..35</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TypeCode" type="ds:LPCOTypeCodeType" minOccurs="0">
          <xs:annotation>
            <xs:documentation source="Dictionary Entry Name">LPCO. Type. Code</xs:documentation>
            <xs:documentation source="Definition">Code specifying the name of a document.</xs:documentation>
            <xs:documentation source="WCO ID">D013</xs:documentation>
            <xs:documentation source="Unique Position ID">0001L</xs:documentation>
            <xs:documentation source="Format">an..3</xs:documentation>
