                              <xs:documentation source="Code List">ISO 3166-1</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="CountryName" type="ds:AddressCountryNameTextType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Address. Country Name. Text</xs:documentation>
                              <xs:documentation source="Definition">Name of the country or other geographical entity.</xs:documentation>
