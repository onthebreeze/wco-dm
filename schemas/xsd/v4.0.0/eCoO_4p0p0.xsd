                              <xs:documentation source="Unique Position ID">0271L</xs:documentation>
                              <xs:documentation source="Format">an..256</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="PostcodeID" type="ds:AddressPostcodeIDType" minOccurs="0">
