                    </xs:element>
                    <xs:element name="RoleCode" type="ds:ConsigneeRoleCodeType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Consignee. Role. Code</xs:documentation>
                        <xs:documentation source="Definition">Code specifying the role of a party.</xs:documentation>
                        <xs:documentation source="WCO ID">R005</xs:documentation>
                        <xs:documentation source="Unique Position ID">0269L</xs:documentation>
