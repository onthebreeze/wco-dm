                              <xs:documentation source="WCO ID">131</xs:documentation>
                              <xs:documentation source="Unique Position ID">0395L</xs:documentation>
                              <xs:documentation source="Format">n..16,6</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="NetNetWeightMeasure" type="ds:GoodsMeasureNetNetWeightMeasureType" minOccurs="0">
