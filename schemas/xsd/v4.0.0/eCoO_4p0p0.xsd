                              <xs:documentation source="Unique Position ID">0271L</xs:documentation>
                              <xs:documentation source="Format">an..9</xs:documentation>
                              <xs:documentation source="Code List">ISO 3166-2 OR User codes</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="CountrySubDivisionName" type="ds:AddressCountrySubDivisionNameTextType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Address. Country Sub Division Name. Text</xs:documentation>
                              <xs:documentation source="Definition">Name of a country subdivision.</xs:documentation>
