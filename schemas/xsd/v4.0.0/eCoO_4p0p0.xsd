                          </xs:element>
                          <xs:element name="CityName" type="ds:AddressCityNameTextType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Address. City Name. Text</xs:documentation>
                              <xs:documentation source="Definition">Name of a city.</xs:documentation>
