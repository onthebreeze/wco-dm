<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:wco:datamodel:WCO:Codex:4"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:ds="urn:wco:datamodel:WCO:Codex_DS:4"
    targetNamespace="urn:wco:datamodel:WCO:Codex:4"
    elementFormDefault="qualified">
  <xs:import namespace="urn:wco:datamodel:WCO:Codex_DS:4" schemaLocation="Codex_4p1p0_urn_wco_datamodel_WCO_Codex_DS_4.xsd"/>
  <xs:element name="LPCO">
    <xs:annotation>
      <xs:documentation source="Definition">Details related to Licenses, Permits, Certificates or Others.</xs:documentation>
      <xs:documentation source="WCO ID">74B</xs:documentation>
      <xs:documentation source="Unique Position ID">0001L</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ID" type="ds:LPCOIdentificationIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation source="Dictionary Entry Name">LPCO. Identification. Identifier</xs:documentation>
            <xs:documentation source="Definition">Identification of a specific document.</xs:documentation>
            <xs:documentation source="Remark">Document reference number, assigned by the Government</xs:documentation>
            <xs:documentation source="WCO ID">D014</xs:documentation>
            <xs:documentation source="Unique Position ID">0001L</xs:documentation>
            <xs:documentation source="Format">an..70</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Authentication" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation source="Definition">Details related to the authentication of a document.</xs:documentation>
            <xs:documentation source="WCO ID">61B</xs:documentation>
            <xs:documentation source="Unique Position ID">0045L</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ActualDateTime" type="ds:AuthenticationActualDateTimeType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Authentication. Actual. Date Time</xs:documentation>
                  <xs:documentation source="Definition">Date and time when this authentication was actually signed or otherwise authenticated.</xs:documentation>
                  <xs:documentation source="WCO ID">451</xs:documentation>
                  <xs:documentation source="Unique Position ID">0045L</xs:documentation>
                  <xs:documentation source="Format">an..35</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Authentication" type="ds:AuthenticationAuthenticationTextType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Authentication. Authentication. Text</xs:documentation>
                  <xs:documentation source="Definition">Statement providing proof that the document has been authenicated.</xs:documentation>
                  <xs:documentation source="WCO ID">104</xs:documentation>
                  <xs:documentation source="Unique Position ID">0045L</xs:documentation>
                  <xs:documentation source="Format">an..256</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Authenticator" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation source="Definition">Details related to an authenticating party.</xs:documentation>
                  <xs:documentation source="WCO ID">12A</xs:documentation>
                  <xs:documentation source="Unique Position ID">0046L</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Name" type="ds:AuthenticatorNameTextType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Authenticator. Name. Text</xs:documentation>
                        <xs:documentation source="Definition">Name of the party which certifies that a document is authentic.</xs:documentation>
                        <xs:documentation source="WCO ID">R007</xs:documentation>
                        <xs:documentation source="Unique Position ID">0046L</xs:documentation>
                        <xs:documentation source="Format">an..70</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ID" type="ds:AuthenticatorIdentificationIDType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Authenticator. Identification. Identifier</xs:documentation>
                        <xs:documentation source="Definition">Identification of a party which certifies that a document is authentic.</xs:documentation>
                        <xs:documentation source="WCO ID">R008</xs:documentation>
                        <xs:documentation source="Unique Position ID">0046L</xs:documentation>
                        <xs:documentation source="Format">an..35</xs:documentation>
                        <xs:documentation source="Code List">International codes (e.g. DUNS, EAN) OR User codes</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="RoleCode" type="ds:AuthenticatorRoleCodeType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Authenticator. Role. Code</xs:documentation>
                        <xs:documentation source="Definition">Code specifying the role of a party.</xs:documentation>
                        <xs:documentation source="WCO ID">R005</xs:documentation>
                        <xs:documentation source="Unique Position ID">0046L</xs:documentation>
                        <xs:documentation source="Format">an..3</xs:documentation>
                        <xs:documentation source="Code List">UN/EDIFACT code list 3035</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="AdditionalInformation" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation source="Definition">Details related to the special request from declarant to government to take or not to take action.</xs:documentation>
            <xs:documentation source="Remark">In case of using Additional statement code, text or indicator you can make the information more specific by also using Additional statement type.
If there are more than 1 occurrences you should always use it in combination with the type.</xs:documentation>
            <xs:documentation source="WCO ID">03A</xs:documentation>
            <xs:documentation source="Unique Position ID">0030L</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="StatementCode" type="ds:AdditionalInformationStatementCodeType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Additional Information. Statement. Code</xs:documentation>
                  <xs:documentation source="Definition">Code specifying the form of an additional statement.</xs:documentation>
                  <xs:documentation source="WCO ID">226</xs:documentation>
                  <xs:documentation source="Unique Position ID">0030L</xs:documentation>
                  <xs:documentation source="Format">an..17</xs:documentation>
                  <xs:documentation source="Code List">User codes</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="StatementDescription" type="ds:AdditionalInformationStatementDescriptionTextType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Additional Information. Statement Description. Text</xs:documentation>
                  <xs:documentation source="Definition">Description of an additional statement.</xs:documentation>
                  <xs:documentation source="WCO ID">225</xs:documentation>
                  <xs:documentation source="Unique Position ID">0030L</xs:documentation>
                  <xs:documentation source="Format">an..512</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="StatementTypeCode" type="ds:AdditionalInformationStatementTypeCodeType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Additional Information. Statement Type. Code</xs:documentation>
                  <xs:documentation source="Definition">Code specifying the subject of the additional statement.</xs:documentation>
                  <xs:documentation source="WCO ID">369</xs:documentation>
                  <xs:documentation source="Unique Position ID">0030L</xs:documentation>
                  <xs:documentation source="Format">an..3</xs:documentation>
                  <xs:documentation source="Code List">UN/EDIFACT code list 4451</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Consignment" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation source="Definition">Details related to the transport between a consignor and a consignee as specified in the transport contract document.</xs:documentation>
            <xs:documentation source="WCO ID">28A</xs:documentation>
            <xs:documentation source="Unique Position ID">0203L</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="TotalPackageQuantity" type="ds:ConsignmentTotalPackageQuantityType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Consignment. Total Package. Quantity</xs:documentation>
                  <xs:documentation source="Definition">Quantity specifying the total number of packages of the entire document (e.g. declaration/consignment).</xs:documentation>
                  <xs:documentation source="WCO ID">146</xs:documentation>
                  <xs:documentation source="Unique Position ID">0203L</xs:documentation>
                  <xs:documentation source="Format">n..8</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="BoardedQuantity" type="ds:ConsignmentBoardedQuantityType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation source="Dictionary Entry Name">Consignment. Boarded. Quantity</xs:documentation>
                  <xs:documentation source="Definition">Quantity specifying the total number shown on bill of lading or on split shipment. It will be the actual number of pieces boarded on the conveyance. (Not necessarily the smallest external packaging unit for the shipment).</xs:documentation>
                  <xs:documentation source="WCO ID">314</xs:documentation>
                  <xs:documentation source="Unique Position ID">0203L</xs:documentation>
                  <xs:documentation source="Format">n..16</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="BorderTransportMeans" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation source="Definition">Details related to the means of transport crossing the border of the Customs territory.</xs:documentation>
                  <xs:documentation source="WCO ID">15A</xs:documentation>
                  <xs:documentation source="Unique Position ID">0250L</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Name" type="ds:BorderTransportMeansNameTextType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Border Transport Means. Name. Text</xs:documentation>
                        <xs:documentation source="Definition">Name to identify the means of transport used for the carriage of the goods in crossing the border.</xs:documentation>
                        <xs:documentation source="WCO ID">T005</xs:documentation>
                        <xs:documentation source="Unique Position ID">0250L</xs:documentation>
                        <xs:documentation source="Format">an..70</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ID" type="ds:BorderTransportMeansIdentificationIDType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Border Transport Means. Identification. Identifier</xs:documentation>
                        <xs:documentation source="Definition">Identification of the means of transport used in crossing the border.</xs:documentation>
                        <xs:documentation source="WCO ID">T006</xs:documentation>
                        <xs:documentation source="Unique Position ID">0250L</xs:documentation>
                        <xs:documentation source="Format">an..35</xs:documentation>
                        <xs:documentation source="Code List">Sea: ITU Standard or Lloyd's number
Air: IATA aircraft ID
Road: national license plate
Rail: locomotive number</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="TypeCode" type="ds:BorderTransportMeansTypeCodeType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Border Transport Means. Type. Code</xs:documentation>
                        <xs:documentation source="Definition">Code specifying type of means of transport used for the carriage of the goods in crossing the border.</xs:documentation>
                        <xs:documentation source="WCO ID">T010</xs:documentation>
                        <xs:documentation source="Unique Position ID">0250L</xs:documentation>
                        <xs:documentation source="Format">an..4</xs:documentation>
                        <xs:documentation source="Code List">UN/Recommendation 28</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ArrivalLocation" minOccurs="0" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation source="Definition">Details related to the first arrival location.</xs:documentation>
                        <xs:documentation source="WCO ID">11C</xs:documentation>
                        <xs:documentation source="Unique Position ID">1969L</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ID" type="ds:ArrivalLocationIdentificationIDType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Arrival Location. Identification. Identifier</xs:documentation>
                              <xs:documentation source="Definition">Identification of the arrival location. This would be a port for sea, airport for air and border post for land crossing.</xs:documentation>
                              <xs:documentation source="WCO ID">L109</xs:documentation>
                              <xs:documentation source="Unique Position ID">1969L</xs:documentation>
                              <xs:documentation source="Format">an..35</xs:documentation>
                              <xs:documentation source="Code List">UN/LOCODE + User codes OR User codes</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Consignee" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation source="Definition">Details related to the party to which goods are consigned.</xs:documentation>
                  <xs:documentation source="WCO ID">27A</xs:documentation>
                  <xs:documentation source="Unique Position ID">0269L</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Name" type="ds:ConsigneeNameTextType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Consignee. Name. Text</xs:documentation>
                        <xs:documentation source="Definition">Name of the party to which goods are consigned.</xs:documentation>
                        <xs:documentation source="WCO ID">R014</xs:documentation>
                        <xs:documentation source="Unique Position ID">0269L</xs:documentation>
                        <xs:documentation source="Format">an..70</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ID" type="ds:ConsigneeIdentificationIDType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Consignee. Identification. Identifier</xs:documentation>
                        <xs:documentation source="Definition">Identification of a party to which goods are consigned.</xs:documentation>
                        <xs:documentation source="WCO ID">R015</xs:documentation>
                        <xs:documentation source="Unique Position ID">0269L</xs:documentation>
                        <xs:documentation source="Format">an..35</xs:documentation>
                        <xs:documentation source="Code List">International codes (e.g. DUNS, EAN) OR User codes</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="RoleCode" type="ds:ConsigneeRoleCodeType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Dictionary Entry Name">Consignee. Role. Code</xs:documentation>
                        <xs:documentation source="Definition">Code specifying the role of a party.</xs:documentation>
                        <xs:documentation source="WCO ID">R005</xs:documentation>
                        <xs:documentation source="Unique Position ID">0269L</xs:documentation>
                        <xs:documentation source="Format">an..3</xs:documentation>
                        <xs:documentation source="Code List">UN/EDIFACT code list 3035</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="ConsignmentItem" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation source="Definition">Details related to an item in a consignment.</xs:documentation>
                  <xs:documentation source="WCO ID">29A</xs:documentation>
                  <xs:documentation source="Unique Position ID">0275L</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="SequenceNumeric" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation source="Definition">Number indicating the position in a sequence.</xs:documentation>
                        <xs:documentation source="WCO ID">006</xs:documentation>
                        <xs:documentation source="Unique Position ID">0275L</xs:documentation>
                        <xs:documentation source="Format">n..5</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Commodity" minOccurs="0" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation source="Definition">Details related to the properties of the goods.</xs:documentation>
                        <xs:documentation source="WCO ID">23A</xs:documentation>
                        <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="SequenceNumeric" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Definition">Number indicating the position in a sequence.</xs:documentation>
                              <xs:documentation source="WCO ID">006</xs:documentation>
                              <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                              <xs:documentation source="Format">n..5</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Description" type="ds:CommodityDescriptionTextType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Commodity. Description. Text</xs:documentation>
                              <xs:documentation source="Definition">Description of the nature of a goods item sufficient to identify it for cross-border regulatory purposes such as customs, phytosanitary, statistical or transport.</xs:documentation>
                              <xs:documentation source="WCO ID">137</xs:documentation>
                              <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                              <xs:documentation source="Format">an..512</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="LotNumberID" type="ds:CommodityLotNumberIDType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Commodity. Lot Number. Identifier</xs:documentation>
                              <xs:documentation source="Definition">Identification of the production lot by number.</xs:documentation>
                              <xs:documentation source="WCO ID">265</xs:documentation>
                              <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                              <xs:documentation source="Format">an..70</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="IntendedUseStatement" type="ds:CommodityIntendedUseStatementTextType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Commodity. Intended Use Statement. Text</xs:documentation>
                              <xs:documentation source="Definition">Statement regarding the intended use of the commodity.</xs:documentation>
                              <xs:documentation source="WCO ID">327</xs:documentation>
                              <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                              <xs:documentation source="Format">an..256</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="IntendedUseCode" type="ds:CommodityIntendedUseCodeType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation source="Dictionary Entry Name">Commodity. Intended Use. Code</xs:documentation>
                              <xs:documentation source="Definition">Code specifying the intended use of the commodity.</xs:documentation>
                              <xs:documentation source="WCO ID">330</xs:documentation>
                              <xs:documentation source="Unique Position ID">0307L</xs:documentation>
                              <xs:documentation source="Format">an..17</xs:documentation>
                              <xs:documentation source="Code List">WCO codes OR User codes</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ApprovedEstablishmentLocation" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation source="Definition">Details related to a facility approved for a specific purpose by a government authority.</xs:documentation>
                              <xs:documentation source="WCO ID">08A</xs:documentation>
                              <xs:documentation source="Unique Position ID">0330L</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Name" type="ds:ApprovedEstablishmentLocationNameTextType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Approved Establishment Location. Name. Text</xs:documentation>
                                    <xs:documentation source="Definition">Name of the location of a facility approved for a specific purpose by a government authority.</xs:documentation>
                                    <xs:documentation source="WCO ID">L057</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0330L</xs:documentation>
                                    <xs:documentation source="Format">an..256</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="ID" type="ds:ApprovedEstablishmentLocationIdentificationIDType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Approved Establishment Location. Identification. Identifier</xs:documentation>
                                    <xs:documentation source="Definition">Identification of a facility approved for a specific purpose by a government authority.</xs:documentation>
                                    <xs:documentation source="WCO ID">L058</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0330L</xs:documentation>
                                    <xs:documentation source="Format">an..35</xs:documentation>
                                    <xs:documentation source="Code List">UN/LOCODE + User codes OR User codes</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="Classification" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation source="Definition">Details related to the non-commercial categorization of a commodity by a standard-setting organization.</xs:documentation>
                              <xs:documentation source="WCO ID">21A</xs:documentation>
                              <xs:documentation source="Unique Position ID">0333L</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ID" type="ds:ClassificationIdentificationIDType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Classification. Identification. Identifier</xs:documentation>
                                    <xs:documentation source="Definition">Identification of the non-commercial categorization of a commodity by a standard-setting organization.</xs:documentation>
                                    <xs:documentation source="WCO ID">145</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0333L</xs:documentation>
                                    <xs:documentation source="Format">an..18</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="NameCode" type="ds:ClassificationNameCodeType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Classification. Name. Code</xs:documentation>
                                    <xs:documentation source="Definition">Code specifying the scientific name of original plant/animal used as a material for food products, medications, cosmetics, medical materials, etc.</xs:documentation>
                                    <xs:documentation source="WCO ID">346</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0333L</xs:documentation>
                                    <xs:documentation source="Format">an..35</xs:documentation>
                                    <xs:documentation source="Code List">UN/EDIFACT code list 7357</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="IdentificationTypeCode" type="ds:ClassificationIdentificationTypeCodeType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Classification. Identification Type. Code</xs:documentation>
                                    <xs:documentation source="Definition">Code specifying the commodity classification  (e.g. Harmonized Tariff Schedule (HTS), Export Control Classification Code (ECCC), UNDG Code list, International Code of Zoological Nomenc).</xs:documentation>
                                    <xs:documentation source="WCO ID">337</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0333L</xs:documentation>
                                    <xs:documentation source="Format">an..3</xs:documentation>
                                    <xs:documentation source="Code List">UN/EDIFACT code list 7143</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="Manufacturer" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation source="Definition">Details related to the party which manufactures goods.</xs:documentation>
                              <xs:documentation source="WCO ID">86A</xs:documentation>
                              <xs:documentation source="Unique Position ID">0352L</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Name" type="ds:ManufacturerNameTextType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Manufacturer. Name. Text</xs:documentation>
                                    <xs:documentation source="Definition">Name of the party that manufactures goods.</xs:documentation>
                                    <xs:documentation source="WCO ID">R042</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0352L</xs:documentation>
                                    <xs:documentation source="Format">an..70</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="ID" type="ds:ManufacturerIdentificationIDType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Manufacturer. Identification. Identifier</xs:documentation>
                                    <xs:documentation source="Definition">Identification of a party which manufactures goods.</xs:documentation>
                                    <xs:documentation source="WCO ID">R043</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0352L</xs:documentation>
                                    <xs:documentation source="Format">an..35</xs:documentation>
                                    <xs:documentation source="Code List">International codes (e.g. DUNS, EAN) OR User codes</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="RoleCode" type="ds:ManufacturerRoleCodeType" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation source="Dictionary Entry Name">Manufacturer. Role. Code</xs:documentation>
                                    <xs:documentation source="Definition">Code specifying the role of a party.</xs:documentation>
                                    <xs:documentation source="WCO ID">R005</xs:documentation>
                                    <xs:documentation source="Unique Position ID">0352L</xs:documentation>
                                    <xs:documentation source="Format">an..3</xs:documentation>
                                    <xs:documentation source="Code List">UN/EDIFACT code list 3035</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="Producer" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation source="Definition">Details related to the producer of the product.</xs:documentation>
                              <xs:documentation source="WCO ID">01B</xs:documentation>
                              <xs:documentation source="Unique Position ID">0355L</xs:documentation>
                            </xs:annotation>
