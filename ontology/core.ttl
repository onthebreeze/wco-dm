wco:typeCode a owl:ObjectProperty ;
    rdfs:label "Type code"@en ;
    skos:definition "Code specifying the name of a document."@en ;
    skos:scopeNote "AEOProgramProfile: Code specifying whether the country’s Authorized Economic Operator (AEO) program is a security based program, compliance based, or both."@en ;
    skos:scopeNote "Action: Code specifying the type of action to be taken."@en ;
    skos:scopeNote "AdditionalDocument: Code specifying the type of an additional document."@en ;
    skos:scopeNote "AdditionalReference: Code specifying the name of an additional reference."@en ;
    skos:scopeNote "Address: Code specifying the type of address."@en ;
    skos:scopeNote "ArrivalTransportMeans: Code specifying means of transport used for the carriage of the goods at arrival."@en ;
    skos:scopeNote "AssociatedTransportDocument: Code specifying the type of associated transport document in a secondary cargo report."@en ;
    skos:scopeNote "Authentication: Code specifying the type of authentication."@en ;
    skos:scopeNote "Authorization: Code specifying the type of authorization necessary for the declaration or notification."@en ;
    skos:scopeNote "BinaryFile: Code specifying the type of binary file, such as photo, spreadsheet."@en ;
    skos:scopeNote "BorderTransportMeans: Code specifying type of means of transport used for the carriage of the goods in crossing the border."@en ;
    skos:scopeNote "Characteristic: Code specifying the subject of the characteristic."@en ;
    skos:scopeNote "Communication: Code specifying the type of communication address."@en ;
    skos:scopeNote "Control: Code specifying the type of governmental examination."@en ;
    skos:scopeNote "ControlOffice: Code specifying the type of control office (e.g. 5 - Customs)."@en ;
    skos:scopeNote "DepartureTransportMeans: Code specifying the type of means of transport used for the carriage of the goods at departure."@en ;
    skos:scopeNote "DutyTaxFee: Code specifying a type of duty or tax applicable to commodities or a type of tax or fee applicable to services."@en ;
    skos:scopeNote "Event: Code specifying the type of an exhibition event."@en ;
    skos:scopeNote "Event: Code specifying the type of an exhibition event."@en ;
    skos:scopeNote "ExaminationLocation: Code specifying the type of examination place."@en ;
    skos:scopeNote "FacilityLocation: Code specifying the facility type."@en ;
    skos:scopeNote "GoodsLocation: Code specifying the type of goods location."@en ;
    skos:scopeNote "HarvestingTransportMeans: Code specifying the type of means of transport used for harvesting."@en ;
    skos:scopeNote "IPR: Code specifying the type of IPR according to WTO TRIPS (e.g. copyright, trademarks, geographical indication, industrial designs, patents, integrated circuits layout designs, undisclosed information and trade secrets, curbing anti-competitive licensing contracts, enforcement: tough but fair, technology transfer, etc.)."@en ;
    skos:scopeNote "Invoice: Code specifying the type of an invoice."@en ;
    skos:scopeNote "MasterDataRecipient: Code specifying the type of regulatory office that receives the master data."@en ;
    skos:scopeNote "MasterDataSender: Code specifying the type of regulatory office that sends the master data."@en ;
    skos:scopeNote "OperationTermination: Code specifying the type of Transit operation termination."@en ;
    skos:scopeNote "Origin: Code specifying the differentiation between different types of origin (e.g. preferential and non-preferential country of origin codes)."@en ;
    skos:scopeNote "Packaging: Code specifying the type of package of an item."@en ;
    skos:scopeNote "PassiveTransportMeans: Code specifying the type of passive means of transport that is being transported by the active means of transport."@en ;
    skos:scopeNote "Payment: Code specifying the type of payment."@en ;
    skos:scopeNote "PersonData: Code specifying the type of person (e.g. Crew member, Passenger, Stowaway)."@en ;
    skos:scopeNote "PreviousDocument: Code specifying the type of document used for declaration previously presented."@en ;
    skos:scopeNote "ProductCharacteristics: Code specifying the commodity characteristics such as goods grading, genetic modification, quality, etc. that distinguishes the commodity from similar commodities."@en ;
    skos:scopeNote "ProductCriteriaConformance: Code specifying conformance with statutory and regulatory requirements."@en ;
    skos:scopeNote "ProgramPartnerProfile: Code specifying the type of program or partner profile (e.g. MRA (Mutual Recognition Arrangement/Agreement), JWP (the Joint Work Plan), PGA (Participating Government Agency))."@en ;
    skos:scopeNote "Seal: Code specifying the type of seal applied on a unit of transport equipment."@en ;
    skos:scopeNote "SealingParty: Code specifying the party affixing or activating the seal for regulatory purposes."@en ;
    skos:scopeNote "Source: Code specifying the type of source location."@en ;
    skos:scopeNote "SupportingDocument: Code specifying the details required by any specific rules applicable together with reference data of the documents produced in support of the declaration."@en ;
    skos:scopeNote "TotalPersons: Code specifying the type of person (e.g. Crew member, Passenger, Stowaway)."@en ;
    skos:scopeNote "TranshipmentLocation: Code specifying the type of location of transhipment."@en ;
    skos:scopeNote "TransitTransportMeans: Code specifying the type of means of transport used for transit."@en ;
    skos:scopeNote "TransportContractDocument: Code specifying the type of a document evidencing a transport contract."@en ;
    skos:scopeNote "TravelDocument: Code specifying the name of a travel document."@en ;
    skos:scopeNote "Warehouse: Code specifying the type of warehouse."@en ;
    skos:scopeNote "WasteDeliveryLocation: Code specifying the type of place/port where waste of any type was or will be delivered (e.g. last or next port)."@en ;
    schema:domainIncludes wco:AEOProgramProfile, wco:AIP, wco:Action, wco:AdditionalDocument, wco:AdditionalReference, wco:Address, wco:ArrivalTransportMeans, wco:AssociatedTransportDocument, wco:Authentication, wco:Authorization, wco:BinaryFile, wco:BorderTransportMeans, wco:Characteristic, wco:Communication, wco:Control, wco:ControlOffice, wco:Declaration, wco:DepartureTransportMeans, wco:DutyTaxFee, wco:Event, wco:ExaminationLocation, wco:FacilityLocation, wco:GoodsLocation, wco:HarvestingTransportMeans, wco:IPR, wco:Invoice, wco:LPCO, wco:MasterDataRecipient, wco:MasterDataSender, wco:OperationTermination, wco:Origin, wco:Packaging, wco:PassiveTransportMeans, wco:Payment, wco:PersonData, wco:PreviousDocument, wco:ProductCharacteristics, wco:ProductCriteriaConformance, wco:ProgramPartnerProfile, wco:Seal, wco:SealingParty, wco:Source, wco:SupportingDocument, wco:TotalPersons, wco:TranshipmentLocation, wco:TransitTransportMeans, wco:TransportContractDocument, wco:TravelDocument, wco:Warehouse, wco:WasteDeliveryLocation ;
    schema:rangeIncludes <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-1001-or-user-code-list>, <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-3035-list>, <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-3227-list>, <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-3227-or-user-code-list>, <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-5153-or-user-code-list>, <https://vocabulary.wcoomd.org/code-list/external/user-code-list>, wco-cl:action-code-list, wco-cl:address-type-code-list, wco-cl:aeo-program-type-code-list, wco-cl:communication-means-type-code-list, wco-cl:government-agency-type-code-list, wco-cl:package-type-code-list, wco-cl:payment-type-code-list, wco-cl:program-partner-profile-type-code-list, wco-cl:reference-type-code-list, wco-cl:sealing-party-type-code-list, wco-cl:transport-means-type-code-list, xsd:string ;
    wco:codeListBasis "UN/ECE Recommendation 21 Annex VI"@en ;
    wco:codeListBasis "UN/EDIFACT code list 1001 OR User code list"@en ;
    wco:codeListBasis "UN/EDIFACT code list 1153. For EU CDM usage: Additional references must be entered in the form of a code defined in Title I. The list of additional references and their respective codes can be found in the TARIC database, their format is a1an3. Member States may define national codes, national codes must have the format n1an3"@en ;
    wco:codeListBasis "UN/EDIFACT code list 1229 OR User code list"@en ;
