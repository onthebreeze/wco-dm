wco:arrivalDateTime a owl:DatatypeProperty ;
    rdfs:label "Arrival date time"@en ;
    skos:definition "Date and time of arrival at itinerary port of the means of transport."@en ;
    skos:scopeNote "ArrivalLocation: Date and time of arrival (actual or scheduled) of the means of transport at the first port (e.g. seaport, airport, freight terminal, rail station)."@en ;
    skos:scopeNote "BorderTransportMeans: Date and time of arrival (actual or scheduled) of the means of transport at the first port (e.g. seaport, airport, freight terminal, rail station)."@en ;
    skos:scopeNote "LoadingLocation: Date and time when declared goods were/will be carried into designated location."@en ;
    skos:scopeNote "UnloadingLocation: Date and time of arrival at port or airport with the intent to unload."@en ;
    skos:scopeNote "Warehouse: Date and time when declared goods were/will be carried into designated location."@en ;
    schema:domainIncludes wco:ArrivalConveyanceFacility, wco:ArrivalLocation, wco:BorderTransportMeans, wco:DepartureConveyanceFacility, wco:Itinerary, wco:LoadingLocation, wco:UnloadingLocation, wco:Warehouse ;
    schema:rangeIncludes xsd:dateTime ;
    wco:xmlTag "ArrivalDateTime" ;
    wco:jsonTag "arrivalDateTime" ;
    wco:attributeId "172", "173", "208", "221" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 102, 110, 121, 174, 190, 221, 228, 832" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

