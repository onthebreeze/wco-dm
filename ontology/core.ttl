wco:identificationIdentifier a owl:DatatypeProperty ;
    rdfs:label "Identification identifier"@en ;
    skos:definition "Identification of a specific document."@en ;
    skos:scopeNote "AEOMutualRecognitionParty: Identification of the AEO mutual recognition party."@en ;
    skos:scopeNote "AcceptanceLocation: Identification of the location where the goods are taken over by the carrier from the consignor."@en ;
    skos:scopeNote "AdditionalDocument: Identification of a document providing additional information."@en ;
    skos:scopeNote "AdditionalIdentifier: Identification of an additional party (e.g. VAT number)."@en ;
    skos:scopeNote "AdditionalReference: Identification of the reference providing additional information."@en ;
    skos:scopeNote "Agent: Identification of a party authorized to act on behalf of another party."@en ;
    skos:scopeNote "AppealOffice: Identification of the location of a government office at which an appeal can be lodged."@en ;
    skos:scopeNote "Applicant: Identification of a party who applies for something."@en ;
    skos:scopeNote "ApprovedEstablishmentLocation: Identification of a facility approved for a specific purpose by a government authority."@en ;
    skos:scopeNote "ArrivalConveyanceFacility: Identification of a terminal, warehouse or yard where a means of transport arrives."@en ;
    skos:scopeNote "ArrivalLocation: Identification of the arrival location. This would be a port for sea, airport for air and border post for land crossing."@en ;
    skos:scopeNote "ArrivalTransportMeans: Identification of the means of transport at the time of arrival."@en ;
    skos:scopeNote "Assembler: Identification of the party responsible for putting together various components or parts into a product or commodity in its form or condition as imported."@en ;
    skos:scopeNote "AssigningParty: Identification of the party who assigns any identifier to a shipment."@en ;
    skos:scopeNote "AssociatedTransportDocument: Identification of a previous transport document number or other assigned reference number associated with the shipment. Applies to secondary cargo document report only."@en ;
    skos:scopeNote "Authentication: Identification of the authentication."@en ;
    skos:scopeNote "Authenticator: Identification of a party which certifies that a document is authentic."@en ;
    skos:scopeNote "Authorization: Identification of an authorization necessary for the declaration or notification."@en ;
    skos:scopeNote "AuthorizationHolder: Identification of the person being the holder of the authorization."@en ;
    skos:scopeNote "AuthorizedPerson: Identification of a person designated under relevant legislation for the purpose of issuing official assurances."@en ;
    skos:scopeNote "BerthLocation: Identification of the location in port where the means of transport will berth."@en ;
    skos:scopeNote "BinaryFile: Identification of this binary file."@en ;
    skos:scopeNote "BorderTransportMeans: Identification of the means of transport used in crossing the border."@en ;
    skos:scopeNote "BorderingOffice: Identification of the government agency office across the border, facing the current object."@en ;
    skos:scopeNote "Buyer: Identification of a party to which merchandise or services are sold."@en ;
    skos:scopeNote "Cabin: Identification of the specific cabin or room on board."@en ;
    skos:scopeNote "CarriedTransportEquipment: Identification of the equipment (e.g. unit load device by marks, letters, and/or numbers)."@en ;
    skos:scopeNote "Carrier: Identification of a party providing the transport of goods between named points."@en ;
    skos:scopeNote "CertificateOfResponsibilityHolder: Identification of the party holding the Certificate of Financial Responsibility (COFR)."@en ;
    skos:scopeNote "Certifier: Identification of a party which certifies something."@en ;
    skos:scopeNote "Classification: Identification of the non-commercial categorization of a commodity by a standard-setting organization."@en ;
    skos:scopeNote "Communication: Identification of the communication address."@en ;
    skos:scopeNote "Consignee: Identification of a party to which goods are consigned."@en ;
    skos:scopeNote "ConsignmentItem: Identification of the consignment item (e.g. for CITES codes A, B, C, D)."@en ;
    skos:scopeNote "Consignor: Identification of the party consigning goods as stipulated in the transport contract by the party ordering the transport."@en ;
    skos:scopeNote "Consolidator: Identification of the freight forwarder combining individual smaller consignments into a single larger consignment (in a consolidation process) that is sent to a counterpart who mirrors the consolidator's activity by dividing the consolidated consignment into its original components."@en ;
    skos:scopeNote "ConsortiumCarrier: Identification of a consortium carrier."@en ;
    skos:scopeNote "ContactOffice: Identification of the location of a government office where contact can be made."@en ;
    skos:scopeNote "ContainerOperator: Identification of the party owning, operating or controlling the transport equipment (e.g. container)."@en ;
    skos:scopeNote "ContainerTerminalOperator: Identification of the party operating a container terminal or similar facility."@en ;
    skos:scopeNote "ControlOffice: Identification of the location of a relevant governmental office where goods are available for further governmental control."@en ;
    skos:scopeNote "CrewMember: Identification of conveyance crew member."@en ;
    skos:scopeNote "DangerousGoodsContactParty: Identification of the dangerous goods contact person/party who can provide detailed information regarding dangerous goods."@en ;
    skos:scopeNote "Declarant: Identification of a party who makes a declaration to an official body or - where legally permitted - in whose name, or on whose behalf, a declaration to an official body is made."@en ;
    skos:scopeNote "DeclarationOffice: Identification of a location at which a declaration is lodged."@en ;
    skos:scopeNote "Deconsolidator: Identification of the receiving party of a consolidated shipment, who divides the latter into its original single consignments and undertakes to make them available to be delivered."@en ;
    skos:scopeNote "DeliveryDestinationParty: Identification of the party to whom goods are to be delivered as required by national legislation or according to national requirements."@en ;
    skos:scopeNote "DepartureConveyanceFacility: Identification of a terminal, warehouse or yard where a means of transport departs."@en ;
    skos:scopeNote "DepartureLocation: Identification of the place of departure of the goods."@en ;
    skos:scopeNote "DepartureTransportMeans: Identification of the means of transport at the time of departure."@en ;
    skos:scopeNote "DestinationLocation: Identification of the location of goods destination."@en ;
    skos:scopeNote "DisembarkationLocation: Identification of a port or location of disembarkation."@en ;
    skos:scopeNote "Distiller: Identification of the person or company whose business it is to extract alcoholic liquors by distillation."@en ;
    skos:scopeNote "Distributor: Identification of the party distributing goods."@en ;
    skos:scopeNote "DomesticDutyTaxParty: Identification of a party responsible for the national VAT or Goods & Services Tax."@en ;
    skos:scopeNote "DraymanOrLighterman: Identification of the bonded party that moves goods within port limits on either land or water."@en ;
    skos:scopeNote "EconomicOperator: Identification of an economic operator in whose premises the goods can be controlled."@en ;
    skos:scopeNote "Effects: Identification of the personal effects."@en ;
    skos:scopeNote "EmbarkationLocation: Identification of a port or location of embarkation."@en ;
    skos:scopeNote "EntryOffice: Identification of the regulatory office at which the goods enter the customs territory of destination."@en ;
    skos:scopeNote "EquipmentOwner: Identification of the owner of the transport equipment."@en ;
    skos:scopeNote "ExaminationLocation: Identification of a location where goods are to be examined if different from the specified goods item location."@en ;
    skos:scopeNote "Exhibitor: Identification of the party who offers items for exhibit or show."@en ;
    skos:scopeNote "ExitOffice: Identification of the location of the regulatory office at which the goods leave or are intended to leave the customs territory of dispatch."@en ;
    skos:scopeNote "ExportOffice: Identification of the office where the export formalities are completed."@en ;
    skos:scopeNote "Exporter: Identification of the party who makes, or on whose behalf the export declaration is made, and who is the owner of the goods or has similar rights of disposal over them at the time when the declaration is accepted."@en ;
    skos:scopeNote "FacilityLocation: Identification of a building or location that provides a particular service or is used for a particular industry."@en ;
    skos:scopeNote "FeedlotParty: Identification of a commercial establishment that feeds livestock."@en ;
    skos:scopeNote "FinalTransportMeansLoadingLocation: Identification of a location where a consignment is placed aboard the final means of transport for the journey to a customs territory of a country or union of countries."@en ;
    skos:scopeNote "FinancialCard: Identification of the financial card."@en ;
    skos:scopeNote "FreeTradeZone: Identification of Free Trade Zone (or Foreign Free Zone) where a particular consignment is to be or has been located."@en ;
    skos:scopeNote "GoodsConsignedLocation: Identification of the location in country or country from which the goods were initially dispatched to the importing country."@en ;
    skos:scopeNote "GoodsLocation: Identification of the location of goods."@en ;
    skos:scopeNote "GoodsReceiptLocation: Identification of the location at which the goods have been or are to be received by the consignee."@en ;
    skos:scopeNote "GovernmentOfficer: Identification of a person appointed to some position of responsibility or authority in the government."@en ;
    skos:scopeNote "GovernmentServiceRequestor: Identification of the person or party requesting inspection, grading, or other government service."@en ;
    skos:scopeNote "Grower: Identification of the person or organization who grows commercial crops."@en ;
    skos:scopeNote "GuaranteeOffice: Identification of the location of a guarantee office."@en ;
    skos:scopeNote "HarvestingTransportMeans: Identification of the harvesting transport means."@en ;
    skos:scopeNote "IMOCompany: Identification of the company shown in the Continuous Synopsis Record (CSR)."@en ;
    skos:scopeNote "IPR: Identification of the Intellectual Property Rights, for example the unique number affixed by the authentication agency to a IPR for identification purposes."@en ;
    skos:scopeNote "ISPSResponsibleParty: Identification of the International Ship and Port Facility Security Code (ISPS) responsible party."@en ;
    skos:scopeNote "Importer: Identification of a party who makes, or on whose behalf a customs clearing agent or other authorized person makes, an import declaration. This may include a person who has possession of the goods or to whom the goods are consigned."@en ;
    skos:scopeNote "InsuranceCompany: Identification of a company engaged in the business of insurance."@en ;
    skos:scopeNote "IntermediateCarrier: Identification of the carrier who transports the goods from consignor to exporting carrier and/or from importing carrier to consignee or between other named points, for a transit (in-bond) movement."@en ;
    skos:scopeNote "IntermediateConsignee: Identification of the intermediate consignees who may take possession of the goods from consignor to exporting carrier and/or from importing carrier to consignee, for a transit (in-bond) movement."@en ;
    skos:scopeNote "Invoice: Identification of an invoice by reference number."@en ;
    skos:scopeNote "Issuer: Identification of the party having issued the document."@en ;
    skos:scopeNote "Itinerary: Identification of a single port of call or other location of the itinerary of a means of transport."@en ;
    skos:scopeNote "ItineraryOffice: Identification of the location of the government agency office related to the itinerary."@en ;
    skos:scopeNote "LPCOAuthorizedParty: Identification of the party to whom the license, permit, certificate, or other required document (LPCO) is issued."@en ;
    skos:scopeNote "LandingLocation: Identification of a landing location, wharf, or quay where ships may tie up and load, unload, or lie at rest."@en ;
    skos:scopeNote "LoadingLocation: Identification of a seaport, airport, freight terminal, rail station or other location at which goods are loaded onto the means of transport being used for their carriage."@en ;
    skos:scopeNote "LoyaltyProgram: Identification of the loyalty program."@en ;
    skos:scopeNote "Manufacturer: Identification of a party which manufactures goods."@en ;
    skos:scopeNote "MasterDataOffice: Identification of the master data government agency office."@en ;
    skos:scopeNote "MasterDataParty: Identification of the party in the context of master data."@en ;
    skos:scopeNote "MasterDataRecipient: Identification of the regulatory office that receives the master data."@en ;
    skos:scopeNote "MasterDataSender: Identification of the regulatory office that sends the master data."@en ;
    skos:scopeNote "NationalReference: Identification of the government registration."@en ;
    skos:scopeNote "NonVesselOperatingCarrier: Identification of a common carrier that does not operate the vessels."@en ;
    skos:scopeNote "NotifyParty: Identification of a party to be notified."@en ;
    skos:scopeNote "Operator: Identification of the operator of a mode of transport (e.g. pilot, driver, master of vessel)."@en ;
    skos:scopeNote "OrganicCertifyingOrganization: Identification of an accredited organization whose business it is to certify organic growth processes."@en ;
    skos:scopeNote "Packer: Identification of the party packing goods."@en ;
    skos:scopeNote "PassiveTransportMeans: Identification of the passive transport means."@en ;
    skos:scopeNote "Payer: Identification of a third person paying an amount of duty."@en ;
    skos:scopeNote "PaymentOffice: Identification of the location of a government office where payment can be or has been made."@en ;
    skos:scopeNote "PermittedPort: Identification of the authorized office through which the authorized party is allowed to bring the goods identified on the LPCO."@en ;
    skos:scopeNote "PersonOnBoard: Identification of the person on board."@en ;
    skos:scopeNote "PortReceptionFacilityProvider: Identification of the port reception facility provider."@en ;
    skos:scopeNote "PresentationOffice: Identification of the location of a government office of presentation."@en ;
    skos:scopeNote "PreviousDocument: Identification of the previous document by number."@en ;
    skos:scopeNote "Principal: Identification of the party (i.e., Principal, Co-principal, or User) who is responsible for fulfilling the obligations covered by the Customs bond or who benefits from being able to obligate a Customs bond."@en ;
    skos:scopeNote "Processor: Identification of a party or person who has or will apply a process."@en ;
    skos:scopeNote "Producer: Identification of the party or person who has produced the product."@en ;
    skos:scopeNote "Product: Identification of an object, for example the unique number affixed by the manufacturer to a product for identification purposes."@en ;
    skos:scopeNote "PropertyOperator: Identification of the registered operator of a property."@en ;
    skos:scopeNote "PropertyOwner: Identification of the owner of the property."@en ;
    skos:scopeNote "Recipient: Identification of the (message) recipient."@en ;
    skos:scopeNote "RefundRecipientParty: Identification of the party to receive refund."@en ;
    skos:scopeNote "RegisteredFacility: Identification of a facility that has been formally documented as compliant with regulations or statutes by a regulatory authority."@en ;
    skos:scopeNote "ReleaseOffice: Identification of a requested office where the decision to release the goods declaration from customs custody is to be made."@en ;
    skos:scopeNote "RepairParty: Identification of  the party responsible for substantial repair of transport equipment."@en ;
    skos:scopeNote "RightHolder: Identification of a right holder which refers to a legal entity or person with exclusive rights to an intellectual property."@en ;
    skos:scopeNote "Seal: Identification of a seal affixed to a piece of transport equipment by number."@en ;
    skos:scopeNote "Seller: Identification of the party selling merchandise or services to a buyer."@en ;
    skos:scopeNote "Sender: Identification of the (message) sender."@en ;
    skos:scopeNote "ShipChandler: Identification of a retail dealer who specializes in supplies or equipment for ships, known as ship's stores."@en ;
    skos:scopeNote "ShipToShipActivityLocation: Identification of a seaport, airport, freight terminal, rail station or other place at which a ship-to-ship activity takes place."@en ;
    skos:scopeNote "Stevedore: Identification of the stevedoring company."@en ;
    skos:scopeNote "StowPosition: Identification of the equipment location on the conveyance."@en ;
    skos:scopeNote "StuffingEstablishment: Identification of the party at whose physical location the goods are loaded into the transport equipment (stuffing establishment)."@en ;
    skos:scopeNote "Submitter: Identification of the party who presents a document or data for the approval, consideration, or decision of another."@en ;
    skos:scopeNote "SubsequentDeclarationOffice: Identification of a customs office location of duty/tax payment at which a subsequent declaration is lodged."@en ;
    skos:scopeNote "SupervisingOffice: Identification of the office responsible for supervising the discharge of a government procedure. It may be different from office of declaration or office of entry."@en ;
    skos:scopeNote "SupplementaryDeclarant: Identification of the supplementary declarant."@en ;
    skos:scopeNote "Supplier: Identification of the party who supplies goods and/or services."@en ;
    skos:scopeNote "SupportingDocument: Identification of the reference number of documents or certificates produced in support of the declaration."@en ;
    skos:scopeNote "Surety: Identification of the party who agrees to be responsible for the debt or obligation of another."@en ;
    skos:scopeNote "Terminal: Identification of the location of a terminal."@en ;
    skos:scopeNote "Ticket: Identification of the ticket."@en ;
    skos:scopeNote "TradingParty: Identification of the party responsible for the trade of commercial products."@en ;
    skos:scopeNote "TranshipmentLocation: Identification of the location where goods are to be transferred from one means of transport to another during the course of one transport operation."@en ;
    skos:scopeNote "TranshipmentTransportMeans: Identification of the means of transport used at the time of transhipment."@en ;
    skos:scopeNote "TransitDepartureLocation: Identification of the location at which the goods depart under customs control of the transit procedure."@en ;
    skos:scopeNote "TransitDestinationLocation: Identification of the location at which the goods are destined under customs control of transit procedure."@en ;
    skos:scopeNote "TransitOffice: Identification of the government office which is responsible for transit formalities enroute."@en ;
    skos:scopeNote "TransitOperationDischargeOffice: Identification of the location of the government agency office related to the transit operation."@en ;
    skos:scopeNote "TransitOperationStartOffice: Identification of the customs office starting a transit operation."@en ;
    skos:scopeNote "TransitOperationTerminationOffice: Identification of the termination office."@en ;
    skos:scopeNote "TransitPrincipal: Identification of the party accepting liability for goods held or moving under a customs authorization and - when applicable - a guarantee."@en ;
    skos:scopeNote "TransitTransportMeans: Identification of the means of transport used for transit."@en ;
    skos:scopeNote "TransportContractDocument: Identification of the document evidencing a transport contract by reference number."@en ;
    skos:scopeNote "TransportEquipment: Identification of the equipment (e.g. unit load device by marks, letters, and/or numbers)."@en ;
    skos:scopeNote "TransportEquipmentLocation: Identification of the location of the transport equipment for which the position and status of a transport equipment is being reported."@en ;
    skos:scopeNote "TransportMeansOperator: Identification of the registered operator of the means of transport."@en ;
    skos:scopeNote "TransportMeansOwner: Identification of the registered owner of means the of transport."@en ;
    skos:scopeNote "TravelAgency: Identification of the travel agency."@en ;
    skos:scopeNote "TravelDocument: Identification of the travel document by number."@en ;
    skos:scopeNote "TreatmentFacilityProvider: Identification of the treatment facility provider."@en ;
    skos:scopeNote "UCR: Identification of the unique number assigned to goods being subject to cross border transactions."@en ;
    skos:scopeNote "UltimateConsignee: Identification of the party who has been designated on the invoice or packing list as the final recipient of the stated merchandise."@en ;
    skos:scopeNote "UnloadingLocation: Identification of a seaport, airport, freight terminal, rail station or other location at which goods are unloaded from the means of transport having been used for their carriage."@en ;
    skos:scopeNote "UnloadingParty: Identification of the party responsible for unloading of goods."@en ;
    skos:scopeNote "VehicleOwner: Identification of the owner of the vehicle."@en ;
    skos:scopeNote "Verifier: Identification of a person recognized under relevant legislation to undertake official assurance verification."@en ;
    skos:scopeNote "Veterinarian: Identification of the person who practices veterinary medicine."@en ;
    skos:scopeNote "Warehouse: Identification of a warehouse where a particular goods shipment will be / is / has been stored."@en ;
