wco:netWeightMeasure a owl:ObjectProperty ;
    rdfs:label "Net weight measure"@en ;
    skos:definition "Measure of the useful capacity of a ship determined in accordance with the provisions of international convention on tonnage measurements of ships, 1969."@en ;
    skos:scopeNote "GoodsMeasure: Weight of goods including any packaging that normally go with the goods."@en ;
    schema:domainIncludes wco:BorderTransportMeans, wco:GoodsMeasure ;
