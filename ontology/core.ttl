wco:nameText a owl:DatatypeProperty ;
    rdfs:label "Name text"@en ;
    skos:definition "Name of the exhibition in cases where goods are sent from the territory of the exporting Party for exhibition in another country and sold during or after the exhibition for importation into the territory of a Party."@en ;
    skos:scopeNote "AcceptanceLocation: Name of the location where the goods are taken over by the carrier from the consignor."@en ;
    skos:scopeNote "AdditionalDocument: Name of the additional document."@en ;
    skos:scopeNote "Agent: Name of a party authorized to act on behalf of another party."@en ;
    skos:scopeNote "Applicant: Name of a party who applies for something."@en ;
    skos:scopeNote "ApprovedEstablishmentLocation: Name of the location of a facility approved for a specific purpose by a government authority."@en ;
    skos:scopeNote "ArrivalConveyanceFacility: Name of the location of the terminal, warehouse or yard where a means of transport arrives."@en ;
    skos:scopeNote "ArrivalLocation: Name of the arrival location. This would be a port for sea, airport for air and border post for land crossing."@en ;
    skos:scopeNote "ArrivalTransportMeans: Name to identify the means of transport used for the carriage of the goods at the time of arrival."@en ;
    skos:scopeNote "Assembler: Name of the party responsible for putting together various components or parts into a product or commodity."@en ;
    skos:scopeNote "Authenticator: Name of the party which certifies that a document is authentic."@en ;
    skos:scopeNote "AuthorizedPerson: Name of a person designated under relevant legislation for the purpose of issuing official assurances."@en ;
    skos:scopeNote "BerthLocation: Name of the location in port where the means of transport will berth."@en ;
    skos:scopeNote "BorderTransportMeans: Name to identify the means of transport used for the carriage of the goods in crossing the border."@en ;
    skos:scopeNote "Buyer: Name of the party to which merchandise or services are sold."@en ;
    skos:scopeNote "CargoFacilityLocation: Name of the terminal, warehouse, or yard where the goods are to be on or off loaded."@en ;
    skos:scopeNote "Carrier: Name of the party providing the transport of goods between named points."@en ;
    skos:scopeNote "Certifier: Name of the party who has provided the certification."@en ;
    skos:scopeNote "Communication: Name of the communication identifier."@en ;
    skos:scopeNote "CompanySecurityOfficer: Name of the company security officer as described in IMO Circular MSC 1130."@en ;
    skos:scopeNote "ConnectionTransportMeans: Name to identify the means of transport used for connection."@en ;
    skos:scopeNote "Consignee: Name of the party to which goods are consigned."@en ;
    skos:scopeNote "Consignor: Name of the party consigning goods as stipulated in the transport contract by the party ordering transport."@en ;
    skos:scopeNote "Consolidator: Name of the party who has combined a number of smaller consignments into a single larger consignment."@en ;
    skos:scopeNote "ConsortiumCarrier: Name of the consortium carrier."@en ;
    skos:scopeNote "Contact: Name of a department or employee."@en ;
    skos:scopeNote "Counterpart: Name of the party opposing to something or someone, especially in a process."@en ;
    skos:scopeNote "DangerousGoodsContactParty: Name of the dangerous goods contact person/party who can provide detailed information regarding dangerous goods."@en ;
    skos:scopeNote "Declarant: Name of the party who makes a declaration to an official body or - where legally permitted - in whose name, or on whose behalf, a declaration to an official body is made."@en ;
    skos:scopeNote "Deconsolidator: Name of the receiving party of a consolidated shipment, who divides the latter into its original single consignments and undertakes to make them available to be delivered."@en ;
    skos:scopeNote "DeliveryDestinationParty: Name of the party to which goods are to be delivered."@en ;
    skos:scopeNote "DepartureConveyanceFacility: Name of the terminal, warehouse or yard where a means of transport departs."@en ;
    skos:scopeNote "DepartureLocation: Name of the departure location."@en ;
    skos:scopeNote "DepartureTransportMeans: Name to identify the means of transport used for the carriage of the goods at the time of departure."@en ;
    skos:scopeNote "DestinationLocation: Name of the destination location."@en ;
    skos:scopeNote "DisembarkationLocation: Name of a port or location of disembarkation."@en ;
    skos:scopeNote "Distiller: Name of the person or company whose business it is to extract alcoholic liquors by distillation."@en ;
    skos:scopeNote "Distributor: Name of the party who has distributed the goods."@en ;
    skos:scopeNote "DomesticDutyTaxParty: Name of the party responsible for the national tax (e.g. Goods and Services Tax, Value-Added Tax)."@en ;
    skos:scopeNote "DraymanOrLighterman: Name of the bonded party that moves goods within port limits on either land or water."@en ;
    skos:scopeNote "EmbarkationLocation: Name of a port or location of embarkation."@en ;
    skos:scopeNote "EquipmentOwner: Name of the owner of the transport equipment."@en ;
    skos:scopeNote "ExaminationLocation: Name of the location where goods are to be examined if different from the specified goods item location."@en ;
    skos:scopeNote "Exhibitor: Name of the party who is offering the items for exhibit or show."@en ;
    skos:scopeNote "Exporter: Name of the person who makes, or on whose behalf the export declaration is made, and who is the owner of the goods or has similar right of disposal over them at the time when the declaration is accepted."@en ;
    skos:scopeNote "FacilityLocation: Name of the building or location that provides a particular service or is used for a particular industry."@en ;
    skos:scopeNote "FeedlotParty: Name of a commercial establishment that feeds livestock."@en ;
    skos:scopeNote "FreeTradeZone: Name of Free Trade Zone (or Foreign Free Zone) were a particular consignment is to be or has been located."@en ;
    skos:scopeNote "GoodsConsignedLocation: Name of the location in a country from which the goods were initially dispatched to the importing country."@en ;
    skos:scopeNote "GoodsLocation: Name of the location where goods are located."@en ;
    skos:scopeNote "GoodsReceiptLocation: Name of the location at which the goods have been or are to be received by the consignee."@en ;
    skos:scopeNote "GovernmentOfficer: Name of a person appointed to some position of responsibility or authority in the government."@en ;
    skos:scopeNote "GovernmentServiceRequestor: Name of the person or party requesting inspection, grading or other government service."@en ;
    skos:scopeNote "Grower: Name of the person or organization who grows commercial crops."@en ;
    skos:scopeNote "IMOCompany: Name of the company shown in the Continuous Synopsis Record (CSR)."@en ;
    skos:scopeNote "ISPSResponsibleParty: Name of the International Ship and Port Facility Security Code (ISPS) responsible party."@en ;
    skos:scopeNote "Importer: Name of the party who makes, or on whose behalf a customs clearing agent or other authorized person makes, an import declaration. This may include a person who is in possession of the goods or to whom the goods are consigned."@en ;
    skos:scopeNote "InsuranceCompany: Name of the company engaged to provide the insurance for the cargo."@en ;
    skos:scopeNote "IntermediateCarrier: Name of the carrier who transports the goods from consignor to exporting carrier and/or from importing carrier to consignee or between other named points."@en ;
    skos:scopeNote "Itinerary: Name of a single port of call or other location in the itinerary of a means of transport."@en ;
    skos:scopeNote "LPCO: Name of the document."@en ;
    skos:scopeNote "LPCOAuthorizedParty: Name of the party to whom the license, permit, certificate, or other required document (LPCO) is issued."@en ;
    skos:scopeNote "LandingLocation: Name of the location of landing, wharf, or quay where ships may tie up and load, unload, or to lie at rest."@en ;
    skos:scopeNote "LoadingLocation: Name of a seaport, airport, freight terminal, rail station or other location at which goods are loaded onto the means of transport being used for their carriage."@en ;
    skos:scopeNote "LoadingProofParty: Name of the authorized party responsible for certifying that the goods were loaded into the transport equipment (proof of vanning)."@en ;
    skos:scopeNote "Manufacturer: Name of the party that manufactures goods."@en ;
    skos:scopeNote "MasterDataOffice: Name of the master data government agency office."@en ;
    skos:scopeNote "MasterDataParty: Name of the party in the context of master data."@en ;
    skos:scopeNote "NotifyParty: Name of party to be notified."@en ;
    skos:scopeNote "Operator: Name of the operator of a mode of transport (e.g. pilot, driver, master of vessel)."@en ;
    skos:scopeNote "OrganicCertifyingOrganization: Name of an accredited organization whose business it is to certify organic growth processes."@en ;
    skos:scopeNote "Packer: Name of the party packing goods."@en ;
    skos:scopeNote "Payer: Name of a third person paying an amount of duty."@en ;
    skos:scopeNote "PortFacilitySecurityOfficer: Name of the individual (person) designated as the port facility security officer responsible for port security requirements."@en ;
    skos:scopeNote "PortReceptionFacilityProvider: Name of the port reception facility provider."@en ;
    skos:scopeNote "Principal: Name of the party (i.e., Principal, Co-principal, or User) who is responsible for fulfilling the obligations covered by the Customs bond or who benefits from being able to obligate a Customs bond."@en ;
    skos:scopeNote "Processor: Name of the party or person who has or will apply a process."@en ;
    skos:scopeNote "Producer: Name of the party or person who has produced the product."@en ;
    skos:scopeNote "PropertyOperator: Name of the registered operator of a property."@en ;
    skos:scopeNote "PropertyOwner: Name of the owner of the property."@en ;
    skos:scopeNote "RecognizedSecurityOrganization: Name of the security organization granting the security certificate."@en ;
    skos:scopeNote "RefundRecipientParty: Name of the party to receive refund."@en ;
    skos:scopeNote "RegisteredFacility: Name of the facility that has been formally documented as compliant with regulations or statutes by a regulatory authority."@en ;
    skos:scopeNote "RepairParty: Name of the party responsible for substantial repair of transport equipment."@en ;
    skos:scopeNote "RepresentativePerson: Name of the representative of the party making the declaration."@en ;
    skos:scopeNote "RightHolder: Name of the right holder that refers to a legal entity or person with exclusive rights to an intellectual property."@en ;
    skos:scopeNote "SealingParty: Name of the party affixing or activating the seal for regulatory purposes."@en ;
    skos:scopeNote "Seller: Name of the party selling merchandise or services to a buyer."@en ;
    skos:scopeNote "ShipChandler: Name of a retail dealer who specializes in supplies or equipment for ships, known as ship's stores."@en ;
    skos:scopeNote "ShipSecurityOfficer: Name of the officer who is appointed as Ship Security Officer."@en ;
    skos:scopeNote "ShipToShipActivityLocation: Name of the location where the ship-to-ship activity takes place."@en ;
    skos:scopeNote "StuffingEstablishment: Name of the party at whose physical location the goods are loaded into the transport equipment (stuffing establishment)."@en ;
    skos:scopeNote "Submitter: Name of the party who presents a document or data for the approval, consideration, or decision of another."@en ;
    skos:scopeNote "Supplier: Name of the party who supplies goods and/or services."@en ;
    skos:scopeNote "Surety: Name of the party who agrees to be responsible for the debt or obligation of another."@en ;
    skos:scopeNote "Terminal: Name of the location where the terminal is situated."@en ;
    skos:scopeNote "TradingParty: Name of the party responsible for the trade of commercial products."@en ;
    skos:scopeNote "TranshipmentLocation: Name of the location where goods are to be transferred from one means of transport to another during the course of one transport operation."@en ;
    skos:scopeNote "TranshipmentTransportMeans: Name to identify means of transport at transhipment."@en ;
    skos:scopeNote "TransitDestinationLocation: Name of the location at which the goods are destined under customs control of transit procedure."@en ;
    skos:scopeNote "TransitPrincipal: Name of the party accepting liability for goods held or moving under a customs authorization and, when applicable, a guarantee."@en ;
    skos:scopeNote "TransportEquipment: Registered name of the equipment used to transport the cargo."@en ;
    skos:scopeNote "TransportEquipmentLocation: Name of the location of the transport equipment for which the position and status of a transport equipment is being reported."@en ;
    skos:scopeNote "TransportMeansOperator: Name of the registered operator of the means of transport."@en ;
    skos:scopeNote "TransportMeansOwner: Name of the registered owner of the means of transport."@en ;
    skos:scopeNote "TravelAgency: Name of the travel agency that made the booking or reservation."@en ;
    skos:scopeNote "TreatmentFacilityProvider: Name of the treatment facility provider."@en ;
    skos:scopeNote "UltimateConsignee: Name of the party who has been designated on the invoice or packing list as the final recipient of the cargo."@en ;
    skos:scopeNote "UnloadingLocation: Name of the unloading location, seaport, airport, freight terminal, rail station or other location at which the cargo is to be unloaded from the means of transport having been used for their carriage."@en ;
    skos:scopeNote "UnloadingParty: Name of the party responsible for unloading the goods."@en ;
    skos:scopeNote "VehicleOwner: Name of the owner of the vehicle."@en ;
    skos:scopeNote "Verifier: Name of the person recognized under relevant legislation to undertake official assurance verification."@en ;
    skos:scopeNote "Veterinarian: Name of the person who practices veterinary medicine."@en ;
    skos:scopeNote "Warehouse: Name of the location of a warehouse where a particular goods shipment will be / is / has been stored."@en ;
    skos:scopeNote "WasteDeliveryLocation: Name of the location/port where waste of any type was or will be delivered."@en ;
