# --------------------------------------------------------------------------
# Properties
# --------------------------------------------------------------------------

wco:accessText a owl:DatatypeProperty ;
    rdfs:label "Access text"@en ;
    skos:definition "Information on access for this binary file such as security and download parameters."@en ;
    schema:domainIncludes wco:BinaryFile ;
    schema:rangeIncludes xsd:string ;
    wco:xmlTag "Access" ;
    wco:jsonTag "access" ;
    wco:attributeId "561" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 975" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

wco:accountIdentificationIdentifier a owl:DatatypeProperty ;
    rdfs:label "Account identification identifier"@en ;
    skos:definition "Identification of the bank account."@en ;
    skos:scopeNote "DeferredPayment: Identification of an account related to deferred payment."@en ;
    schema:domainIncludes wco:Bank, wco:DeferredPayment ;
    schema:rangeIncludes <https://vocabulary.wcoomd.org/code-list/external/iban-swift-bic-codes-list>, xsd:string ;
    wco:codeListBasis "IBAN /SWIFT /BIC Codes"@en ;
    wco:xmlTag "AccountID" ;
    wco:jsonTag "accountId" ;
    wco:attributeId "372", "578" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 1123, 963" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

wco:acknowledgementRequestIndicator a owl:DatatypeProperty ;
    rdfs:label "Acknowledgement request indicator"@en ;
    skos:definition "Indicator requesting acknowledgement of the interchange."@en ;
    schema:domainIncludes wco:CommunicationMetaData ;
    schema:rangeIncludes xsd:boolean ;
    wco:xmlTag "AcknowledgementRequestIndicator" ;
    wco:jsonTag "acknowledgementRequestIndicator" ;
    wco:attributeId "MD01" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 14" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

wco:acquisitionDateTime a owl:DatatypeProperty ;
    rdfs:label "Acquisition date time"@en ;
    skos:definition "Date and time the commodity was acquired."@en ;
    schema:domainIncludes wco:Commodity ;
    schema:rangeIncludes xsd:dateTime ;
    wco:xmlTag "AcquisitionDateTime" ;
    wco:jsonTag "acquisitionDateTime" ;
    wco:attributeId "456" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 1032" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

wco:actionCode a owl:ObjectProperty ;
    rdfs:label "Action code"@en ;
    skos:definition "Code specifying the action to be taken or already taken."@en ;
    schema:domainIncludes wco:Consignment, wco:ConsignmentItem, wco:TransportEquipment ;
    schema:rangeIncludes wco-cl:action-code-list ;
    wco:codeListBasis "UN/EDIFACT code list 1229 OR User code list"@en ;
    wco:xmlTag "ActionCode" ;
    wco:jsonTag "actionCode" ;
    wco:attributeId "460" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 1058, 1072, 1410" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

wco:actualDateTime a owl:DatatypeProperty ;
