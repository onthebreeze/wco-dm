wco:identificationTypeCode a owl:ObjectProperty ;
    rdfs:label "Identification type code"@en ;
    skos:definition "Code specifying the type of identification used to identify a location."@en ;
    skos:scopeNote "ArrivalTransportMeans: Code specifying type of identifier of the means of transport used for the carriage of the goods at arrival."@en ;
    skos:scopeNote "BorderTransportMeans: Code specifying type of identifier of the means of transport used for the carriage of the goods in crossing the border."@en ;
    skos:scopeNote "Classification: Code specifying the commodity classification (e.g. Harmonized Tariff Schedule (HTS), Export Control Classification Code (ECCC), UNDG Code list, International Code of Zoological Nomenclature)."@en ;
    skos:scopeNote "DepartureTransportMeans: Code specifying the type of identifier of the means of transport at departure."@en ;
    skos:scopeNote "PassiveTransportMeans: Code specifying type of identification of passive transport means."@en ;
    skos:scopeNote "TranshipmentTransportMeans: Code specifying the type of identification of transhipment transport means."@en ;
    schema:domainIncludes wco:ArrivalTransportMeans, wco:BorderTransportMeans, wco:Classification, wco:DepartureTransportMeans, wco:GoodsLocation, wco:PassiveTransportMeans, wco:TranshipmentTransportMeans ;
    schema:rangeIncludes <https://vocabulary.wcoomd.org/code-list/external/un-edifact-code-list-7143-list>, wco-cl:goods-location-identification-type-code-list, wco-cl:transport-means-identification-type-code-list ;
    wco:codeListBasis "E.g. IMO, MMSI, Call sign, External sign, ENI"@en ;
    wco:codeListBasis "UN/EDIFACT code list 7143"@en ;
    wco:codeListBasis "User code list (see EU CDM code list for DE 16 15 046 000)"@en ;
    wco:xmlTag "IdentificationTypeCode" ;
    wco:jsonTag "identificationTypeCode" ;
    wco:attributeId "337", "571", "T018", "T027", "T029", "T032", "T034" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 1002, 165, 819, 827, 879, 889, 895" ;
    rdfs:isDefinedBy wco-mod:core ;
    wco:termStatus ts:active .

