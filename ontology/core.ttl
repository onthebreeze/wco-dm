wco:descriptionText a owl:DatatypeProperty ;
    rdfs:label "Description text"@en ;
    skos:definition "Description of this binary file."@en ;
    skos:scopeNote "Classification: Description of the classification in plain language."@en ;
    skos:scopeNote "Commodity: Description of the nature of a goods item sufficient to identify it for cross-border regulatory purposes such as customs, phytosanitary, statistical or transport."@en ;
    skos:scopeNote "ControlResult: Description of the control results."@en ;
    skos:scopeNote "Defects: Description of the defects noted."@en ;
    skos:scopeNote "Effects: Description of personal belongings in the possession of individual crew members or passengers which according to regulations in force at the location of arrival of a means of transport are dutiable or subject to prohibitions or restrictions."@en ;
    skos:scopeNote "Error: Description of a data validation error."@en ;
    skos:scopeNote "GovernmentProcedure: Description of a government procedure."@en ;
    skos:scopeNote "ProductCharacteristics: Description of the commodity characteristics (e.g. goods grading, genetic modification, quality, etc.) that distinguishes the commodity from similar commodities."@en ;
    skos:scopeNote "ProductCriteriaConformance: Statement indicating specific conformance with statutory and regulatory requirements."@en ;
    skos:scopeNote "ProductName: Name or term that identifies the goods assigned by a seller as distinct from those of other sellers, in legal terms known as trademark, which helps to identify one item, a family of items, or all items of that seller."@en ;
    skos:scopeNote "ShipToShipActivity: Description of ship-to-ship activity."@en ;
    skos:scopeNote "TradeTerms: Description of delivery or transport terms."@en ;
    schema:domainIncludes wco:BinaryFile, wco:Classification, wco:Commodity, wco:ControlResult, wco:Defects, wco:Effects, wco:Error, wco:GovernmentProcedure, wco:ProductCharacteristics, wco:ProductCriteriaConformance, wco:ProductName, wco:ShipToShipActivity, wco:TradeTerms ;
    schema:rangeIncludes xsd:string ;
    wco:xmlTag "Description" ;
    wco:jsonTag "description" ;
    wco:attributeId "089", "137", "229", "258", "304", "353", "364", "419", "467", "488", "497", "518", "562" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 1004, 1013, 1097, 1120, 1144, 1150, 1203, 1288, 1293, 1295, 1332, 1385, 976" ;
