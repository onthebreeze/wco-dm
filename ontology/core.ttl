    skos:definition "Date and time when this authentication was actually signed or otherwise authenticated."@en ;
    schema:domainIncludes wco:Authentication ;
    schema:rangeIncludes xsd:dateTime ;
    wco:xmlTag "ActualDateTime" ;
    wco:jsonTag "actualDateTime" ;
