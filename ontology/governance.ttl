# WCO Data Model vocabulary — governance.ttl
# Generated by scripts/build_vocabulary.py from intermediate/. Do not edit by hand.
# Source: WCO Data Model releases 4.0.0 to 4.3.0, raw-data/.

@prefix wco:     <https://vocabulary.wcoomd.org/> .
@prefix wco-mod: <https://vocabulary.wcoomd.org/module/> .
@prefix wco-cl:  <https://vocabulary.wcoomd.org/code-list/> .
@prefix ts:      <https://vocabulary.wcoomd.org/term-status/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

wco-mod:governance a owl:Ontology ;
    rdfs:label "WCO Data Model — governance"@en ;
    dcterms:description "Annotation properties and the lifecycle scheme used by the vocabulary itself."@en ;
    dcterms:source "WCO Data Model releases 4.0.0 to 4.3.0"@en .


wco:termStatus a owl:AnnotationProperty ;
    rdfs:label "term status"@en ;
    rdfs:comment "Governance lifecycle state of a term; a value from the term-status scheme."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:classId a owl:AnnotationProperty ;
    rdfs:label "class ID"@en ;
    rdfs:comment "The class identifier carried by the WCO Data Model library."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:attributeId a owl:AnnotationProperty ;
    rdfs:label "attribute ID"@en ;
    rdfs:comment "The attribute identifier carried by the WCO Data Model library."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:xmlTag a owl:AnnotationProperty ;
    rdfs:label "XML tag name"@en ;
    rdfs:comment "The XML tag name the WCO Data Model assigns to this property."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:jsonTag a owl:AnnotationProperty ;
    rdfs:label "JSON tag name"@en ;
    rdfs:comment "The JSON tag name the WCO Data Model assigns to this property."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:codeListBasis a owl:AnnotationProperty ;
    rdfs:label "code list basis"@en ;
    rdfs:comment "The external list a code list is based on, where WCO does not own the values."@en ;
    rdfs:isDefinedBy wco-mod:governance .

wco:codeListOrigin a owl:AnnotationProperty ;
    rdfs:label "code list origin"@en ;
    rdfs:comment "Whether the list is registered in the WCO code list register, or only referenced by the model."@en ;
    rdfs:isDefinedBy wco-mod:governance .

# The term-status scheme, on the vocab.unece.org lifecycle.

ts:scheme a skos:ConceptScheme ; rdfs:label "WCO vocabulary term status"@en .

ts:proposed a skos:Concept ; skos:inScheme ts:scheme ;
    skos:prefLabel "proposed"@en ; skos:definition "Put forward, not yet part of the published model."@en .

ts:active a skos:Concept ; skos:inScheme ts:scheme ;
    skos:prefLabel "active"@en ; skos:definition "Part of the published WCO Data Model."@en .

ts:deprecated a skos:Concept ; skos:inScheme ts:scheme ;
    skos:prefLabel "deprecated"@en ; skos:definition "Still published, but its use is discouraged."@en .

ts:retired a skos:Concept ; skos:inScheme ts:scheme ;
    skos:prefLabel "retired"@en ; skos:definition "Withdrawn; retained so that existing references resolve."@en .
