    wco:xmlTag "EmbarkationDateTime" ;
    wco:jsonTag "embarkationDateTime" ;
    wco:attributeId "489" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 144" ;
    rdfs:isDefinedBy wco-mod:location ;
    wco:termStatus ts:active .

wco:goodsLocationIdentificationTypeCode a owl:ObjectProperty ;
