    wco:xmlTag "AuthorizationID" ;
    wco:jsonTag "authorizationId" ;
    wco:attributeId "595" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 166" ;
    rdfs:isDefinedBy wco-mod:location ;
    wco:termStatus ts:active .

