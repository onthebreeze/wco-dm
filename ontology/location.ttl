wco:anchorageIndicator a owl:DatatypeProperty ;
    rdfs:label "Anchorage indicator"@en ;
    skos:definition "Indicator of the arrival of vessels at anchorage location or departure of vessels from anchorage location."@en ;
    schema:domainIncludes wco:ArrivalConveyanceFacility, wco:DepartureConveyanceFacility ;
    schema:rangeIncludes xsd:boolean ;
    wco:xmlTag "AnchorageIndicator" ;
    wco:jsonTag "anchorageIndicator" ;
    wco:attributeId "461" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 101, 120" ;
    rdfs:isDefinedBy wco-mod:location ;
    wco:termStatus ts:active .

wco:authorizationIdentifier a owl:DatatypeProperty ;
    rdfs:label "Authorization identifier"@en ;
