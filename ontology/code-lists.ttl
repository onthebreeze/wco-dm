wco-cl:transaction-nature-type-code a skos:ConceptScheme ;
    rdfs:label "TransactionNatureTypeCode"@en ;
    wco:codeListBasis "WCO code list/TransactionNatureTypeCode (n1) + User code (n1) Remark: * First digit indicates WCO code table value; * Second digit can be used as additional user code to further define first digit"@en ;
    dcterms:source "DataSet 1.6:118" ;
    rdfs:isDefinedBy wco-mod:code-lists ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/1> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "1" ;
    skos:prefLabel "Transactions involving actual or intended transfer of ownership from residents to non-residents against financial or other compensation (except the transactions listed under 2, 7, 8)"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/2> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "2" ;
    skos:prefLabel "Return and replacement of goods free of charge after registration of the original transaction"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/3> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "3" ;
    skos:prefLabel "Transactions involving transfer of ownership without financial or in-kind compensation (e.g. aid shipments)"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/4> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "4" ;
    skos:prefLabel "Operations with a view to processing (2) under contract (no transfer of ownership to the processor)"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/5> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "5" ;
    skos:prefLabel "Operations following processing under contract (no transfer of ownership to the processor)"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/6> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "6" ;
    skos:prefLabel "Particular transactions recorded for national purposes"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/7> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "7" ;
    skos:prefLabel "Operations under joint defence projects or other joint intergovernmental production programmes"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/8> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "8" ;
    skos:prefLabel "Transactions involving the supply of building materials and technical equipment under a general construction or civil engineering contract for which no separate invoicing of the goods is required and an invoice for the total contract is issued"@en ;
    wco:termStatus ts:active .

<https://vocabulary.wcoomd.org/code-list/transaction-nature-type-code/9> a skos:Concept ; skos:inScheme wco-cl:transaction-nature-type-code ;
    skos:notation "9" ;
    skos:prefLabel "Other transactions which cannot be classified under other codes"@en ;
    wco:termStatus ts:active .

