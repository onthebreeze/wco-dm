    skos:definition "Identification of the referral request received. Note for EU CDM users: This data element shall only be provided where the declaration is amended upon a referral request (Annex B DA)."@en ;
    schema:domainIncludes wco:Declaration ;
    schema:rangeIncludes xsd:string ;
    wco:xmlTag "ReferralRequestReferenceID" ;
    wco:jsonTag "referralRequestReferenceId" ;
    wco:attributeId "587" ;
    dcterms:source "DataSet 1.2, 1.3, 1.4 rows 698" ;
    rdfs:isDefinedBy wco-mod:document ;
    wco:termStatus ts:active .

wco:rejectionDateTime a owl:DatatypeProperty ;
    rdfs:label "Rejection date time"@en ;
    skos:definition "Date and time when the document/message was rejected."@en ;
    schema:domainIncludes wco:Declaration, wco:LPCO ;
    schema:rangeIncludes xsd:dateTime ;
    wco:xmlTag "RejectionDateTime" ;
