    skos:definition "Supplementary component Amount Currency. Identifier of the Amount. Type core data type."@en ;
    schema:domainIncludes wco:Amount ;
    schema:rangeIncludes xsd:string ;
    dcterms:source "DataSet 1.5:4" ;
    rdfs:isDefinedBy wco-mod:data-types ;
