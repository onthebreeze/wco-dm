wco:modeCode a owl:ObjectProperty ;
    rdfs:label "Mode code"@en ;
    skos:definition "Code specifying mode of transport used for carriage of the goods at arrival."@en ;
    skos:scopeNote "BorderTransportMeans: Code specifying mode of transport used for the carriage of the goods in crossing the border."@en ;
    skos:scopeNote "ConnectionTransportMeans: Code specifying the mode of transport used for connection."@en ;
    skos:scopeNote "DepartureTransportMeans: Code specifying the mode of transport used for the carriage of the goods at departure."@en ;
