    skos:scopeNote "TransitTransportMeans: Code specifying the mode of transport used for transit."@en ;
    schema:domainIncludes wco:ArrivalTransportMeans, wco:BorderTransportMeans, wco:ConnectionTransportMeans, wco:DepartureTransportMeans, wco:HarvestingTransportMeans, wco:TransitTransportMeans ;
    schema:rangeIncludes wco-cl:transport-means-mode-code ;
