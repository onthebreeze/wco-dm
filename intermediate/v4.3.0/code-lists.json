 {
  "seq": "116",
  "name": "TransactionNatureTypeCode",
  "basis": "WCO code list/TransactionNatureTypeCode (n1) + User code (n1)\nRemark:\n* First digit indicates WCO code table value;\n* Second digit can be used as additional user code to further define first digit",
  "codes": [
   {
    "code": "1",
    "description": "Transactions involving actual or intended transfer of ownership from residents to non-residents against financial or other compensation (except the transactions listed under 2, 7, 8)"
   },
   {
    "code": "2",
    "description": "Return and replacement of goods free of charge after registration of the original transaction"
   },
   {
    "code": "3",
    "description": "Transactions involving transfer of ownership without financial or in-kind compensation (e.g. aid shipments)"
   },
   {
    "code": "4",
    "description": "Operations with a view to processing (2) under contract (no transfer of ownership to the processor)"
   },
   {
    "code": "5",
    "description": "Operations following processing under contract (no transfer of ownership to the processor)"
   },
   {
    "code": "6",
    "description": "Particular transactions recorded for national purposes"
   },
   {
    "code": "7",
    "description": "Operations under joint defence projects or other joint intergovernmental production programmes"
   },
   {
    "code": "8",
    "description": "Transactions involving the supply of building materials and technical equipment under a general construction or civil engineering contract for which no separate invoicing of the goods is required and an invoice for the total contract is issued"
   },
   {
    "code": "9",
    "description": "Other transactions which cannot be classified under other codes"
   }
  ],
  "external": false,
  "source": {
   "file": "1.1 WCO DM LIB V4.3.0.xlsx",
   "sheet": "DataSet 1.6",
   "row": 118
  }
