@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
title sad 4.0.0  —  top level by vocabulary module
class "Declaration" as ROOT <<root>>
class "core (9)" as M0 {
  AdditionalInformation
  Authentication
  CurrencyExchange
  DutyTaxFee
  GoodsMeasure
  GoodsShipment
  GovernmentProcedure
  Packaging
  UCR
}
ROOT *-- M0
class "party (6)" as M1 {
  Agent
  Carrier
  Declarant
  Exporter
  Importer
  Submitter
}
ROOT *-- M1
class "document (3)" as M2 {
  AdditionalDocument
  ObligationGuarantee
  PreviousDocument
}
ROOT *-- M2
class "government (1)" as M3 {
  DeclarationOffice
}
ROOT *-- M3
class "location (1)" as M4 {
  LoadingLocation
}
ROOT *-- M4
note as N
  Each box is one vocabulary module and lists the top-level
  classes of this message that belong to it.
end note
@enduml
