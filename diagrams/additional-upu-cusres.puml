@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
left to right direction
title UPU CUSRES
class "AIP" as C0 <<root>> {
  2 elements
}
class "AdditionalInformation" as C1 {
  3 elements
}
class "AEOProgramProfile" as C2 {
  6 elements
}
class "Control" as C3 {
  1 element
}
class "TransitPrincipal" as C4 {
  2 elements
}
class "Status" as C5 {
  1 element
}
class "Communication" as C6 {
  3 elements
}
class "TradeRole" as C7 {
  1 element
}
class "Contact" as C8 {
  1 element
}
class "ProgramPartnerProfile" as C9 {
  5 elements
}
class "ControlResult" as C10 {
  1 element
}
class "Address" as C11 {
  4 elements
}
class "AdditionalIdentifier" as C12 {
  3 elements
}
class "Authorization" as C13 {
  1 element
}
class "Communication" as C14 {
  2 elements
}
class "AuthorizationWithdrawal" as C15 {
  2 elements
}
class "Exclusion" as C16 {
  3 elements
}
C0 *-- "0..*" C1
C0 *-- "0..*" C2
C0 *-- "0..*" C3
C0 *-- "0..*" C4
C0 *-- "0..*" C5
C2 *-- "0..*" C6
C2 *-- "0..*" C7
C2 *-- "0..*" C8
C2 *-- "0..*" C9
C3 *-- "0..*" C10
C4 *-- "0..*" C11
C4 *-- "0..*" C12
C4 *-- "0..*" C13
C8 *-- "0..*" C14
C13 *-- "0..*" C15
C13 *-- "0..*" C16
