  6 elements
}
class "AdditionalInformation" as C2 {
  1 element
}
class "AdditionalDocument" as C3 {
  3 elements
}
class "Principal" as C4 {
  6 elements
}
class "NotifyParty" as C5 {
  1 element
}
class "Surety" as C6 {
  4 elements
}
class "Agent" as C7 {
  1 element
}
C0 *-- "0..*" C1
C1 *-- "0..*" C2
C1 *-- "0..*" C3
