@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
left to right direction
title msw 4.0.0
class "AIP" as C0 <<root>> {
  4 elements
}
class "Submitter" as C1 {
  1 element
}
class "AdditionalInformation" as C2 {
  2 elements
}
class "Error" as C3 {
  2 elements
}
class "Declaration" as C4
class "LPCO" as C5
class "Pointer" as C6 {
  2 elements
}
C0 *-- "0..*" C1
C0 *-- "0..*" C2
C0 *-- "0..*" C3
C0 *-- "0..*" C4
C0 *-- "0..*" C5
C3 *-- "0..*" C6
@enduml
