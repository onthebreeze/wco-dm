@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
left to right direction
title AEO Master Data 4.1.0
class "AIP" as C0 <<root>> {
  3 elements
}
class "MasterDataRecipient" as C1 {
  2 elements
}
class "MasterDataSender" as C2 {
  2 elements
}
class "MasterDataParty" as C3 {
  6 elements
}
class "Address" as C4 {
  7 elements
}
class "Contact" as C5 {
  2 elements
}
class "Communication" as C6 {
  2 elements
}
class "AdditionalIdentifier" as C7 {
  3 elements
}
class "AdditionalDocument" as C8 {
  6 elements
}
class "Communication" as C9 {
  2 elements
}
C0 *-- "0..*" C1
C0 *-- "0..*" C2
C0 *-- "0..*" C3
C3 *-- "0..*" C4
C3 *-- "0..*" C5
C3 *-- "0..*" C6
C3 *-- "0..*" C7
C3 *-- "0..*" C8
C5 *-- "0..*" C9
