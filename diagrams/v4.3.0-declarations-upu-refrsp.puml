@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
left to right direction
title UPU REFRSP 4.3.0
class "Declaration" as C0 <<root>> {
  7 elements
}
class "AdditionalDocument" as C1 {
  2 elements
}
class "AdditionalInformation" as C2 {
  3 elements
}
class "Control" as C3 {
  1 element
}
class "Status" as C4 {
  1 element
}
class "Pointer" as C5 {
  2 elements
}
class "Certifier" as C6 {
  1 element
}
class "ControlResult" as C7 {
  1 element
}
C0 *-- "0..*" C1
C0 *-- "0..*" C2
C0 *-- "0..*" C3
C0 *-- "0..*" C4
C2 *-- "0..*" C5
C3 *-- "0..*" C6
C3 *-- "0..*" C7
@enduml
