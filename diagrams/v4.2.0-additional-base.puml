@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
title Additional 4.2.0  —  top level by vocabulary module
class "AIP" as ROOT <<root>>
class "core (7)" as M0 {
  AEOProgramProfile
  AdditionalInformation
  Amendment
  Bank
  Control
  Error
  Status
}
ROOT *-- M0
class "government (6)" as M1 {
  AppealOffice
  ContactOffice
  MasterDataOffice
  MasterDataRecipient
  MasterDataSender
  PaymentOffice
}
ROOT *-- M1
class "party (5)" as M2 {
  Authenticator
  InsuranceCompany
  MasterDataParty
  Submitter
  TransitPrincipal
}
ROOT *-- M2
class "document (4)" as M3 {
  AdditionalDocument
  Declaration
  LPCO
  ObligationGuarantee
}
ROOT *-- M3
note as N
  Each box is one vocabulary module and lists the top-level
  classes of this message that belong to it.
end note
@enduml
