@startuml
hide circle
hide empty members
hide stereotype
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam nodesep 10
skinparam ranksep 35
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0B4EA2
  ArrowColor #5B6B7C
  FontColor #14202E
}
skinparam class<<root>> {
  BackgroundColor #0B4EA2
  FontColor #FFFFFF
  BorderColor #083A7A
}
skinparam class<<more>> {
  BackgroundColor #F6F9FC
  BorderColor #9FB3C8
}
title Declaration 4.0.0  —  top level by vocabulary module
class "Declaration" as ROOT <<root>>
class "party (25)" as M0 {
  AEOMutualRecognitionParty
  Agent
  AuthorizationHolder
  Carrier
  CertificateOfResponsibilityHolder
  CompanySecurityOfficer
  ContainerTerminalOperator
  Declarant
  Exporter
  ISPSResponsibleParty
  Importer
  InsuranceCompany
  Payer
  PortFacilitySecurityOfficer
  PropertyOperator
  PropertyOwner
  RecognizedSecurityOrganization
  RepresentativePerson
  ShipChandler
  ShipSecurityOfficer
  Stevedore
  Submitter
  SupplementaryDeclarant
  Surety
  TransitPrincipal
}
ROOT *-- M0
class "core (19)" as M1 {
  Action
  AdditionalInformation
  Amendment
  Authentication
  Bank
  Consignment
  Control
  CurrencyExchange
  DeferredPayment
  DutyTaxFee
  GoodsMeasure
  GoodsShipment
  GovernmentProcedure
  NationalReference
  Packaging
  SplitConsignment
  Status
  Temperature
  UCR
}
ROOT *-- M1
class "government (10)" as M2 {
  DeclarationOffice
  EntryOffice
  ExitOffice
  ExportOffice
  PresentationOffice
  ReleaseOffice
  ResponsibleGovernmentAgency
  SubsequentDeclarationOffice
  SupervisingOffice
  TransitOperationStartOffice
}
ROOT *-- M2
class "location (6)" as M3 {
  ApprovedEstablishmentLocation
  FinalTransportMeansLoadingLocation
  LandingLocation
  LoadingLocation
  ShipToShipActivityLocation
  UnloadingLocation
}
ROOT *-- M3
class "document (6)" as M4 {
  AdditionalDocument
  Authorization
  DeclarationGuarantee
  ObligationGuarantee
  PreviousDocument
  TravelDocument
}
ROOT *-- M4
class "transport (1)" as M5 {
  BorderTransportMeans
}
ROOT *-- M5
note as N
  Each box is one vocabulary module and lists the top-level
  classes of this message that belong to it.
end note
@enduml
